PORT=5000
NODE_ENV=production
# Cryptographically secure random secret (min 32 chars; e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
JWT_EXPIRATION=24h
# Specific allowed origins (wildcard * is blocked in production)
CORS_ORIGIN=https://your-domain.example.com
